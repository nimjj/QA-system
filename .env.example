# ============================================================
# QA Analysis System - Environment Configuration (.env)
# ============================================================

# 1. Pipeline & Machine Learning Engine
# Active pipeline flow: 'v3' (recommended production flow) or 'v2'
LAYA_FLOW=v3

# Checkpoint model path.
# Leave empty ("") to load the stock Laya decision model automatically from Hugging Face cache.
# To use a fine-tuned checkpoint, provide the path (e.g. models/final-softce-3)
LAYA_CHECKPOINT=

# Decision engine language model (default: english)
LAYA_MODEL=english

# Device to run torch on: 'cpu' (default for production container) or 'cuda'
LAYA_DEVICE=cpu

# Persistent Hugging Face / weights cache folder
# Container default: /app/models (mounted to host ./models)
HF_HOME=./models

# 2. QA Backend Service Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8006

# 3. PostgreSQL Database Configuration
# Used for tenant-specific criteria lookups and toggles (app.qa_tenant_criteria).
# If database is unreachable, service automatically falls back safely to criteria.json.
# Local development: localhost. Docker container connecting to host: host.docker.internal
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ciap
DB_USER=postgres
DB_PASSWORD=your-password


# Allowed CORS origins separated by comma (default: "*" allows all origins)
CORS_ORIGINS=*

# Maximum allowable request body size in bytes (default: 2,000,000 bytes = 2 MB, returns 413 if exceeded)
MAX_REQUEST_BYTES=2000000

# 5. Logging & Audit
# Set to '1' or 'true' to log full request bodies for local debugging.
# Set to '0' or 'false' in production to protect personal data (customer names and transcripts are redacted).
LOG_REQUEST_BODIES=0
