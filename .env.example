# ============================================================
# Local & Docker Environment Configuration
# ============================================================

# 1. Laya Decision Engine (replaces Ollama)
# Checkpoint used for every yes/no check
LAYA_MODEL=english
# Folder with the downloaded Laya weights (Hugging Face cache). Leave empty to use ../laya-test/hf_home
# when it exists, otherwise the default Hugging Face cache (downloads ~1.5 GB on first use).
LAYA_HF_HOME=
# Optional torch device: cpu or cuda (empty = automatic)
LAYA_DEVICE=

# 2. QA Backend Service Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8006

# 3. PostgreSQL Configuration
# Local run: localhost. Inside Docker (Postgres on the host): host.docker.internal
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ciap
DB_USER=postgres
DB_PASSWORD=your-password

# 4. API Gateway Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8005
# Local run: http://localhost:8006. Inside the Docker network: http://qa_service:8006
APP_URL=http://localhost:8006
