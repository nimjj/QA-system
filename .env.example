# ============================================================
# Local & Docker Environment Configuration
# ============================================================

# 1. Local LLM Configuration (Ollama)
# For Localhost (without Docker): http://localhost:11434
# For Docker Containers on sentiment/qa network: http://qa_ollama:11434
OLLAMA_HOST=http://qa_ollama:11434
LLM_MODEL=llama3.1
EMBED_MODEL=nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=1800

# 2. QA Backend Service Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8006

# 3. Prompts Configuration
PROMPT_SUMMARY_PATH=resources/prompts/summary_prompt.txt
PROMPT_SUGGESTIONS_PATH=resources/prompts/suggestions_prompt.txt
PROMPT_SCORECARD_PATH=resources/prompts/scorecard_prompt.txt
PROMPT_DYNAMIC_EVALUATION_PATH=resources/prompts/dynamic_evaluation_prompt.txt

# 4. PostgreSQL Configuration
# When Postgres runs on Host Machine, use host.docker.internal inside Docker
# For local Python execution without Docker, use localhost
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=ciap
DB_USER=postgres
DB_PASSWORD=your-password

# 5. API Gateway Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8005
# Inside Docker Network, use http://qa_service:8006. On local machine, use http://localhost:8006
APP_URL=http://qa_service:8006
