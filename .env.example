# ============================================================
# QA Analysis System - Environment Configuration (.env)
# ============================================================

# 1. Pipeline & Machine Learning Engine
# Active pipeline flow: 'v3' (recommended production flow) or 'v2'
LAYA_FLOW=v3

# Production model: the fine-tuned Laya checkpoint. Its weights are NOT in git; download them once and put them in
# models/final-softce-3 (link and check: models/README.md). A relative path is read from the repo root (/app in Docker).
# If the folder is missing the service refuses to grade (GET /ready answers 503) rather than quietly using another model.
# Outside Docker an EMPTY value means the stock Laya model from the Hugging Face cache; not for production (it needs internet and grades
# less accurately). docker-compose.yml turns an empty value back into the default above.
LAYA_CHECKPOINT=models/final-softce-3

# Decision engine language model (default: english)
LAYA_MODEL=english

# Device to run torch on: 'cpu' (default for production container) or 'cuda'
LAYA_DEVICE=cpu

# Docker needs no HF_HOME / HF_HUB_OFFLINE setting: docker-compose.yml sets both (the model never touches the network).
# Only for a stock-model run outside Docker: HF_HOME=<folder for the Hugging Face cache>

# 2. QA Backend Service Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8006

# 3. PostgreSQL Database Configuration
# Used for tenant-specific criteria lookups and toggles (app.qa_tenant_criteria).
# If database is unreachable, service automatically falls back safely to criteria.json.
# Local development: localhost. Inside Docker "localhost" is the container itself, so use the database's own host name,
# or host.docker.internal when PostgreSQL runs on the Docker host (docker-compose.yml maps it, also on Linux).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ciap
DB_USER=postgres
DB_PASSWORD=your-password


# Optional API key. When set, every /api/ call must send it in the x-api-key header (/health and /ready stay open).
# Leave empty to keep the service open (fine on a private network).
QA_API_KEY=

# Allowed CORS origins separated by comma (default: "*" allows all origins)
CORS_ORIGINS=*

# Maximum allowable request body size in bytes (default: 2,000,000 bytes = 2 MB, returns 413 if exceeded)
MAX_REQUEST_BYTES=2000000

# 5. Logging & Audit
# Set to '1' or 'true' to log full request bodies for local debugging.
# Set to '0' or 'false' in production to protect personal data (customer names and transcripts are redacted).
LOG_REQUEST_BODIES=0
