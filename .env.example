# ============================================================
# Local & Docker Environment Configuration
# ============================================================

# 1. Laya Decision Engine (replaces Ollama)
# Checkpoint used for every yes/no check
LAYA_MODEL=english
# Folder with the downloaded Laya weights (Hugging Face cache). Leave empty to use ../laya-test/hf_home
# when it exists, otherwise the default Hugging Face cache (downloads ~1.5 GB on first use).
LAYA_HF_HOME=
# Optional torch device: cpu or cuda (empty = automatic)
LAYA_DEVICE=

# Fine-tuned checkpoint (optional). When set, the app serves it instead of the stock model, applies the fine-tuned
# cutoffs and uses "flow v2" (Docs/FLOW_V2.md). A relative path is read from the repo root. The weights are not in git
# (see laya-finetuning/docs/NEW_PC_SETUP.md). Uncomment once the folder exists.
# LAYA_CHECKPOINT=laya-finetuning/checkpoints/final-softce-3
# Which pipeline runs. Unset = pipeline v2 (the original; snippets by flow v2 with a fine-tuned checkpoint, flow v1 for stock Laya).
# v3 = the new pipeline in src/v3 (built-in criteria, no database, job queue; Docs/V3.md). v1 / v2 force the snippet-cutting rule only.
# LAYA_FLOW=
# Active listening second candidate source (1 = on). Only for ft5 / ft6; leave unset for final-softce-3.
# LAYA_AL_SOURCE2=

# 2. QA Backend Service Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8006

# 3. PostgreSQL Configuration
# Local run: localhost. Inside Docker (Postgres on the host): host.docker.internal
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ciap
DB_USER=postgres
DB_PASSWORD=your-password

# 4. API Gateway Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8005
# Local run: http://localhost:8006. Inside the Docker network: http://qa_service:8006
APP_URL=http://localhost:8006

# 5. Optional service settings (all have safe defaults; the first four apply to pipeline v3)
# Calls allowed to wait in line for the single model worker, and how long POST /api/evaluate waits before answering 503 with a job id
# QUEUE_MAX=50
# EVALUATE_TIMEOUT_SEC=120
# Largest request body accepted, in bytes (413 above it)
# MAX_REQUEST_BYTES=2000000
# When set, every /api/ call must send this value in the x-api-key header (unset = open)
# QA_API_KEY=
# Comma-separated browser origins allowed by CORS (unset = any origin, without cookies)
# CORS_ORIGINS=
# 1 = write full request bodies (transcripts, customer names) to the logs. Leave off on any machine that sees real calls.
# LOG_REQUEST_BODIES=
